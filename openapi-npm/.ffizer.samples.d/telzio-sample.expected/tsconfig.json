{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "moduleResolution": "Node16",
    "module": "Node16",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "rootDir": "./src",
    "outDir": "dist",
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "noUncheckedIndexedAccess": true,

    "removeComments": true,
  },
  "include": [
    "src/**/*.ts",
    "test"
  ]
}
